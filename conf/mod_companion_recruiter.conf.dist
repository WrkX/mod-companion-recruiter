[ModuleConf]

# Master switch.
CompanionRecruiter.Enabled = 1

# Players below this level cannot recruit companions.
CompanionRecruiter.MinimumLevel = 10

# Multiplier for temporary contracts. The base price rises each level from
# 1 silver at level 10 to 30 silver at level 40 and 1 gold at level 60.
# Set to 0 for free temporary contracts.
CompanionRecruiter.CostMultiplier = 1.0

# Flat one-time gold price for a companion saved permanently to one character.
# This does not depend on the owner's level or the temporary cost multiplier.
CompanionRecruiter.PermanentCostGold = 75

# Maximum number of companions a character may own permanently.
CompanionRecruiter.MaxOwnedCompanions = 20

# Normal temporary contract duration (3 hours).
CompanionRecruiter.LifetimeMinutes = 180

# Refund and remove a companion that cannot log in within this many seconds,
# or cannot join within this many seconds after preparation. Clamped to 30-600.
CompanionRecruiter.LoginTimeoutSeconds = 120

# Fresh bot spell, skill, gear, and supply initialization is deliberately
# paced on the world thread. Clamped to 1-5 companions per one-second update.
CompanionRecruiter.PreparationsPerUpdate = 2

# Once a contract expires, dead players and players in instances retain their
# companions. This grace period begins (or is refreshed) while protected.
CompanionRecruiter.ProtectInInstances = 1
CompanionRecruiter.ExpiryGraceMinutes = 10

# One player plus this maximum must fit within the 40-player raid cap.
CompanionRecruiter.MaxCompanionsPerPlayer = 39
